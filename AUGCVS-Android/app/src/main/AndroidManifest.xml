<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AUGCVS"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Splash Screen Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AUGCVS.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard Activities -->
        <activity
            android:name=".activities.ExternalDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegistrarDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />

        <!-- Verification Activities -->
        <activity
            android:name=".activities.VerificationListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SubmitVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.VerificationDetailActivity"
            android:exported="false" />

        <!-- Graduate Activities -->
        <activity
            android:name=".activities.GraduateListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.GraduateDetailActivity"
            android:exported="false" />

        <!-- User Activities -->
        <activity
            android:name=".activities.UserListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserDetailActivity"
            android:exported="false" />

        <!-- Chat Activities -->
        <activity
            android:name=".activities.ChatListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
